#!/bin/sh
# Repository pre-commit checks (secrets, conflict markers, framework gates).
# Installed by `npm run hooks:install` via core.hooksPath=.githooks
set -e

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

if ! command -v node >/dev/null 2>&1; then
	echo "pre-commit: node not found — skipping repository checks." >&2
	exit 0
fi

exec node "$root/tools/git-hooks/pre-commit.mjs"
